# Copy to .env and fill in values. Never commit .env.

# --- OpenAI (Step 5 RAG) ---
OPENAI_API_KEY=

# Optional (omit to use defaults in rag_app/services/llm.py). Add later only if you want specific models.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini

# You usually do not need OPENAI_BASE_URL unless you’re using a proxy or a non-default endpoint.
# Optional override (default https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1
