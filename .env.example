# Copy to .env and fill in values. Never commit .env.
# In production (Azure App Service) set these as App Service environment variables instead.

# --- AI provider: "openai" (default) or "azure" ---
LLM_PROVIDER=openai

# --- OpenAI (when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Azure OpenAI (when LLM_PROVIDER=azure) ---
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini

# --- Optional tuning (defaults shown) ---
# LLM_TIMEOUT_SECONDS=30
# EMBED_BATCH_SIZE=96
# THROTTLE_ASK_RATE=30/hour
# THROTTLE_INGEST_RATE=10/hour
# THROTTLE_AGENT_RATE=15/hour
# RETRIEVAL_MODE=hybrid          # default search for /api/ask/: hybrid or vector
# RERANK_CANDIDATES=12            # chunks the re-ranker scores when rerank=true
# AGENT_MAX_STEPS=5               # tool-calling rounds before the agent must answer
# LOG_LEVEL=INFO

# --- Ingest lock ---
# Unset locally = anyone can ingest. In production ingest is locked unless this is set,
# and then callers must send it in the X-Ingest-Key header.
# INGEST_API_KEY=

# --- Production only (DJANGO_ENV=prod) — see DEPLOY_AZURE.md ---
# DJANGO_ENV=prod
# SECRET_KEY=
# DATABASE_URL=postgres://user:password@server.postgres.database.azure.com:5432/aiassistant
# ALLOWED_HOSTS=your-api.azurewebsites.net
# CSRF_TRUSTED_ORIGINS=https://your-api.azurewebsites.net
# CORS_ALLOWED_ORIGINS=https://your-frontend.azurestaticapps.net
# SEED_DEMO=true
